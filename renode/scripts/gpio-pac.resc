mach create "stm32f407-gpio-pac"

# Charger la carte
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl

# Ajouter la LED virtuelle sur PD12
machine LoadPlatformDescription @renode/platforms/gpio-pac.repl

# Charger le firmware Rust
sysbus LoadELF @target/thumbv7em-none-eabihf/release/gpio-pac

# Démarrer la simulation
start